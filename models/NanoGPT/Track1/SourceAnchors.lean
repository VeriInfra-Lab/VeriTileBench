    """fp32(1) / fp32(w_s), the reciprocal ATen's bf16 division by the Python scalar w_s uses."""
    return (torch.tensor(1.0, dtype=torch.float32) / torch.tensor(w_s, dtype=torch.float32)).reshape(1).to(device)

