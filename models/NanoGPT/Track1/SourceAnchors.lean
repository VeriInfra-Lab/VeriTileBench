def candidateReplicatedSpanKernel : String := r#""""Hopper tiles for the replicated Adam update over the existing flat buffers."""
import torch
import triton
import triton.language as tl

BLOCK = 512


def span_tiles(segments: list[tuple[int, int]]) -> list[tuple[int, int, int]]:
    """Intersect each parameter's flat interval with the aligned tile grid."""
    tiles = []
    begin = 0
    for segment, length in segments:
        end = begin + length
        for block in range(begin // BLOCK, triton.cdiv(end, BLOCK)):
            tile_start = block * BLOCK
            lo, hi = max(begin, tile_start), min(end, tile_start + BLOCK)
            if lo < hi:
                tiles.append((lo, hi, segment))
        begin = end
    return tiles


@triton.jit
def _span_adam(P, G, EA, ES, PLAN, SC, BLOCK: tl.constexpr):
    pid = tl.program_id(0)
    lo = tl.load(PLAN + pid * 3)
    hi = tl.load(PLAN + pid * 3 + 1)
    segment = tl.load(PLAN + pid * 3 + 2)
    offs = lo // BLOCK * BLOCK + tl.arange(0, BLOCK)
    base = segment * 8
    b1 = tl.load(SC + base)
    a1 = tl.load(SC + base + 1)
    b2 = tl.load(SC + base + 2)
    a2 = tl.load(SC + base + 3)
    eps = tl.load(SC + base + 4)
    step_size = tl.load(SC + base + 5)
    wd = tl.load(SC + base + 6)
    active = tl.load(SC + base + 7)
    m = (offs >= lo) & (offs < hi) & (active != 0.0)

    g = tl.load(G + offs, mask=m, other=0.0).to(tl.float32)
    ea = tl.load(EA + offs, mask=m, other=0.0)
    es = tl.load(ES + offs, mask=m, other=0.0)
    p = tl.load(P + offs, mask=m, other=0.0).to(tl.float32)
    ea = tl.math.fma(a1, g, ea * b1)
    es = tl.math.fma(a2 * g, g, es * b2)
    u = ea / (tl.sqrt(es) + eps) * step_size
    u = tl.math.fma(wd * p, tl.where(u * p > 0.0, 1.0, 0.0), u)
    tl.store(EA + offs, ea, mask=m)
    tl.store(ES + offs, es, mask=m)
    tl.store(P + offs, (p - u).to(P.dtype.element_ty), mask=m)


def update_spans(param: torch.Tensor, grad: torch.Tensor, exp_avg: torch.Tensor,
                 exp_avg_sq: torch.Tensor, spans: torch.Tensor, scalars: torch.Tensor) -> None:
    """The immutable span descriptors are constructed with the flat buffers."""
    _span_adam[(spans.shape[0],)](param, grad, exp_avg, exp_avg_sq, spans, scalars, BLOCK=BLOCK, num_warps=4)
"#

def candidateAnvilEpilogueKernel : String := r#""""Fuse the private ANVIL equalized gradient into its parameter update."""
import torch
import triton

TORCH_REVISION = "449b1768410104d3ed79d3bcfe4ba1d65c7f22c0"
BANKS = {
    (3, 2816, 768): -1,  # MLP
    (2, 768, 768): -1,   # VO
    (6, 256, 768): -2,   # QK
}


def _epilogue(v, energy, beta2, red_dim, p, mantissa, wd, lr, gate):
    lane_power = v.float().square().mean(dim=red_dim, keepdim=True)
    length = v.size(red_dim)
    pre_norm = lane_power.sum(dim=(-2, -1), keepdim=True).mul_(length).sqrt_()
    energy.lerp_(lane_power.to(dtype=energy.dtype), 1 - beta2)
    gain = energy.clamp_min(1e-10).rsqrt_()
    post_power = (lane_power * length) * gain.float().square()
    post_norm = post_power.sum(dim=(-2, -1), keepdim=True).sqrt_()
    scale = gain * (pre_norm / post_norm.clamp_min_(1e-10))
    # Preserve the BF16 store from the separate equalizer inside the fused graph.
    update = torch.bitwise_or((v * scale.type_as(v)).view(torch.int16), 0).view(torch.bfloat16).float()

    raw = (p.to(torch.uint32) << 16) | mantissa.to(torch.uint32)
    precise = raw.view(torch.float32)
    aligned = (gate.float() * precise) >= 0
    wd_factor = wd.to(torch.float32)
    lr_factor = lr.to(torch.float32)
    precise.copy_(precise - (precise * aligned * wd_factor * lr_factor) - (update * lr_factor))
    p.copy_((raw >> 16).to(torch.uint16))
    mantissa.copy_(raw.to(torch.uint16))


update_epilogue = torch.compile(_epilogue, dynamic=False, fullgraph=True)


def eligible(v, energy, p, mantissa, wd, lr, gate, beta2, red_dim):
    if (torch.version.git_version != TORCH_REVISION or triton.__version__ != "3.6.0"
            or v.device.type != "cuda" or torch.cuda.get_device_capability(v.device) != (9, 0)
            or beta2 != 0.9 or BANKS.get(tuple(v.shape)) != red_dim):
        return False
    matrices, rows, columns = v.shape
    lane_shape = (matrices, rows, 1) if red_dim == -1 else (matrices, 1, columns)
    inputs = ((v, torch.bfloat16, v.shape), (energy, torch.float32, lane_shape),
              (p, torch.uint16, v.shape), (mantissa, torch.uint16, v.shape),
              (wd, torch.float32, ()), (lr, torch.float32, (matrices, 1, 1)),
              (gate, torch.float32, v.shape))
    return all(t.device == v.device and t.dtype == dtype and tuple(t.shape) == shape
               and t.is_contiguous() for t, dtype, shape in inputs) and all(
                   t.data_ptr() % 16 == 0 for t in (v, energy, p, mantissa, gate))
