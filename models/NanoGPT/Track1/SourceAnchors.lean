__device__ __forceinline__ void ce_decode_pair(uint16_t bytes, float &lo, float &hi) {
    asm("{ .reg .b32 halves; .reg .b16 low, high; "
        "cvt.rn.f16x2.e4m3x2 halves, %2; "
