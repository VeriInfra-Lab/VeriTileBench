    model: nn.Module = GPT(
        vocab_size=50257,
        num_layers=11,
        num_heads=6,
        head_dim=128,
        model_dim=768,
        max_seq_len=val_tokens_per_rank,
        ngram_dim=NGRAM_DIM,
        world_size=env.world_size,
        device=env.device,
    ).cuda()
