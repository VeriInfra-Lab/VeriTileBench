def _packed_batched_matrix_amax_partial_kernel(
    first, second, partial_amax,
    FIRST_ELEMENTS: tl.constexpr,
    SECOND_ELEMENTS: tl.constexpr,
    FIRST_STRIDE_B: tl.constexpr,
    SECOND_STRIDE_B: tl.constexpr,
    NUM_PARTS: tl.constexpr,
    BLOCK_SIZE: tl.constexpr,
):
    """Amax over a logical row-pack without materializing the concatenation."""
    batch = tl.program_id(0)
    part = tl.program_id(1)
    total_elements = FIRST_ELEMENTS + SECOND_ELEMENTS
    offsets = tl.arange(0, BLOCK_SIZE)
    local_amax = tl.zeros((BLOCK_SIZE,), tl.float32)
    for start in tl.range(part * BLOCK_SIZE, total_elements, NUM_PARTS * BLOCK_SIZE):
        indices = start + offsets
        valid = indices < total_elements
        in_first = indices < FIRST_ELEMENTS
        first_values = tl.load(first + batch * FIRST_STRIDE_B + indices, mask=valid & in_first, other=0.0)
        second_indices = tl.maximum(indices - FIRST_ELEMENTS, 0)
        second_values = tl.load(second + batch * SECOND_STRIDE_B + second_indices, mask=valid & ~in_first, other=0.0)
        values = first_values.to(tl.float32) + second_values.to(tl.float32)
        local_amax = tl.maximum(local_amax, tl.abs(values))
    tl.store(partial_amax + batch * NUM_PARTS + part, tl.max(local_amax, axis=0))


@triton.jit
def _quantize_dual_layout_packed_batched_kernel(
    first, second, row, transposed, scale_ptr,
    M, N,
    FIRST_ROWS: tl.constexpr,
    FIRST_STRIDE_B: tl.constexpr,
    SECOND_STRIDE_B: tl.constexpr,
    ROW_STRIDE_B: tl.constexpr,
    TRANSPOSED_STRIDE_B: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_N: tl.constexpr,
):
    """Quantize a logical row-pack directly from its two source allocations: one read of each source,
    two fp8 writes (row-major, and transposed via a register-tile tl.trans)."""
    batch = tl.program_id(2)
    offs_m = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_n = tl.program_id(1) * BLOCK_N + tl.arange(0, BLOCK_N)
    valid = (offs_m[:, None] < M) & (offs_n[None, :] < N)
    in_first = offs_m[:, None] < FIRST_ROWS
    first_offsets = offs_m[:, None] * N + offs_n[None, :]
    second_rows = tl.maximum(offs_m - FIRST_ROWS, 0)
    second_offsets = second_rows[:, None] * N + offs_n[None, :]
    source_ptrs = tl.where(in_first, first + batch * FIRST_STRIDE_B + first_offsets,
                           second + batch * SECOND_STRIDE_B + second_offsets)
    values = tl.load(source_ptrs, mask=valid, other=0.0).to(tl.float32)
    scaled = values / tl.load(scale_ptr + batch)
    quantized = tl.maximum(tl.minimum(scaled, 448.0), -448.0).to(tl.float8e4nv)
    tl.store(row + batch * ROW_STRIDE_B + offs_m[:, None] * N + offs_n[None, :], quantized, mask=valid)
    transposed_mask = (offs_n[:, None] < N) & (offs_m[None, :] < M)
    tl.store(transposed + batch * TRANSPOSED_STRIDE_B + offs_n[:, None] * M + offs_m[None, :],
             tl.trans(quantized), mask=transposed_mask)


@triton.jit
def _aligned_packed_amax(
    first, second, partial_amax,
    FIRST_ELEMENTS: tl.constexpr,
    SECOND_ELEMENTS: tl.constexpr,
    FIRST_STRIDE_B: tl.constexpr,
    SECOND_STRIDE_B: tl.constexpr,
    NUM_PARTS: tl.constexpr,
    BLOCK_SIZE: tl.constexpr,
    QK_CROP: tl.constexpr = False,
    V_CROP: tl.constexpr = False,
):
    tl.static_assert(NUM_PARTS == 32)
    tl.static_assert(FIRST_ELEMENTS % BLOCK_SIZE == 0)
    tl.static_assert(SECOND_ELEMENTS % BLOCK_SIZE == 0)
    if QK_CROP or V_CROP:
        tl.static_assert(BLOCK_SIZE == 2048)
    first_tiles: tl.constexpr = FIRST_ELEMENTS // BLOCK_SIZE
    total_tiles: tl.constexpr = (FIRST_ELEMENTS + SECOND_ELEMENTS) // BLOCK_SIZE
    batch = tl.program_id(0)
    part = tl.program_id(1)
    lane = tl.arange(0, BLOCK_SIZE)
    first_count = (first_tiles + NUM_PARTS - 1 - part) // NUM_PARTS
    total_count = (total_tiles + NUM_PARTS - 1 - part) // NUM_PARTS
    local_amax = tl.zeros((BLOCK_SIZE,), tl.float32)
    for i in tl.range(0, first_count):
        tile = part + i * NUM_PARTS
        if QK_CROP:
            tile += (tile // 24) * 24  # A cropped head spans 64 * 768 elements.
        values = tl.load(first + batch * FIRST_STRIDE_B + tile * BLOCK_SIZE + lane).to(tl.float32)
        # The original masked V operand supplies +0. Preserve that FP add.
        local_amax = tl.maximum(local_amax, tl.abs(values + 0.0))
    for i in tl.range(first_count, total_count):
        tile = part + i * NUM_PARTS - first_tiles
        if V_CROP:
            tile += (tile // 24) * 24
        values = tl.load(second + batch * SECOND_STRIDE_B + tile * BLOCK_SIZE + lane).to(tl.float32)
        # Here the original masked QK operand supplies +0 on the left.
        local_amax = tl.maximum(local_amax, tl.abs(0.0 + values))
    tl.store(partial_amax + batch * NUM_PARTS + part, tl.max(local_amax, axis=0))


@triton.jit
def _qkv_scale_combine(a, b):
    return tl.maximum(a, b, propagate_nan=tl.PropagateNan.ALL)


@triton.jit
def _qkv_scale_from_partials(partial_amax, scales):
    batch = tl.program_id(0)
    parts = tl.arange(0, 32)
    partials = tl.load(partial_amax + batch * 32 + parts)
    amax = tl.reduce(partials, 0, _qkv_scale_combine)
    # The reference clamp leaves NaN unchanged. The multiply has FP32 operands.
    floored = tl.where(amax < 1.0e-12, 1.0e-12, amax)
    tl.store(scales + batch, floored * (1.0 / 448.0))


@triton.jit
def _quantize_aligned_qkv_tiles(
    first, second, row, transposed, scale_ptr,
    M: tl.constexpr,
    N: tl.constexpr,
    FIRST_ROWS: tl.constexpr,
    FIRST_STRIDE_B: tl.constexpr,
    SECOND_STRIDE_B: tl.constexpr,
    ROW_STRIDE_B: tl.constexpr,
    TRANSPOSED_STRIDE_B: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_N: tl.constexpr,
):
    tl.static_assert(FIRST_ROWS % BLOCK_M == 0 and M % BLOCK_M == 0 and N % BLOCK_N == 0)
    batch = tl.program_id(2)
    start_m = tl.program_id(0) * BLOCK_M
    start_n = tl.program_id(1) * BLOCK_N
    rows = tl.arange(0, BLOCK_M)
    cols = tl.arange(0, BLOCK_N)
    # The tile starts and ends inside one bank. Select one base per CTA.
    in_first = start_m < FIRST_ROWS
    bank = tl.where(in_first, first, second)
    pitch = tl.where(in_first, FIRST_STRIDE_B, SECOND_STRIDE_B)
    bank_row = start_m - tl.where(in_first, 0, FIRST_ROWS)
    source = bank + batch * pitch + bank_row * N
    values = tl.load(source + rows[:, None] * N + start_n + cols[None, :]).to(tl.float32)
    scaled = values / tl.load(scale_ptr + batch)
    quantized = tl.maximum(tl.minimum(scaled, 448.0), -448.0).to(tl.float8e4nv)
    offs_m = start_m + rows
    offs_n = start_n + cols
    tl.store(row + batch * ROW_STRIDE_B + offs_m[:, None] * N + offs_n[None, :], quantized)
    tl.store(transposed + batch * TRANSPOSED_STRIDE_B + offs_n[:, None] * M + offs_m[None, :],
             tl.trans(quantized))


@gluon.jit
def _quantize_qkv_tiles_gluon(
    first, second, row, transposed, scale_ptr,
    M: gl.constexpr,
    N: gl.constexpr,
    FIRST_ROWS: gl.constexpr,
    FIRST_STRIDE_B: gl.constexpr,
    SECOND_STRIDE_B: gl.constexpr,
    ROW_STRIDE_B: gl.constexpr,
    TRANSPOSED_STRIDE_B: gl.constexpr,
    BLOCK_M: gl.constexpr,
    BLOCK_N: gl.constexpr,
    QK_CROP: gl.constexpr = False,
    V_CROP: gl.constexpr = False,
):
    gl.static_assert(BLOCK_M == 64 and BLOCK_N == 128)
    gl.static_assert(FIRST_ROWS % BLOCK_M == 0 and M % BLOCK_M == 0 and N % BLOCK_N == 0)
    INPUT: gl.constexpr = gl.BlockedLayout([2, 8], [4, 8], [8, 1], [1, 0])
    TRANS: gl.constexpr = gl.BlockedLayout([8, 2], [1, 32], [8, 1], [0, 1])
    batch = gl.program_id(2)
    start_m = gl.program_id(0) * BLOCK_M
    start_n = gl.program_id(1) * BLOCK_N
    rows = gl.arange(0, BLOCK_M, layout=gl.SliceLayout(1, INPUT))
    cols = gl.arange(0, BLOCK_N, layout=gl.SliceLayout(0, INPUT))
    qk = start_m < FIRST_ROWS
    bank = gl.where(qk, first, second)
    pitch = gl.where(qk, FIRST_STRIDE_B, SECOND_STRIDE_B)
    bank_row = start_m - gl.where(qk, 0, FIRST_ROWS)
    bank_row = bank_row * gl.where(qk, 2 if QK_CROP else 1, 2 if V_CROP else 1)
    source = bank + batch * pitch + bank_row * N
    values = gl.load(source + rows[:, None] * N + start_n + cols[None, :]).to(gl.float32)
    scaled = values / gl.load(scale_ptr + batch)
    quantized = gl.maximum(gl.minimum(scaled, 448.0), -448.0).to(gl.float8e4nv)
    offs_m = start_m + rows
    offs_n = start_n + cols
    gl.store(row + batch * ROW_STRIDE_B + offs_m[:, None] * N + offs_n[None, :], quantized)
    # Each warp moves its own FP8 bytes and reuses its scratch for both column halves.
    moved = gl.convert_layout(quantized, TRANS)
    trans_m = start_m + gl.arange(0, BLOCK_M, layout=gl.SliceLayout(1, TRANS))
    trans_n = start_n + gl.arange(0, BLOCK_N, layout=gl.SliceLayout(0, TRANS))
    gl.store(transposed + batch * TRANSPOSED_STRIDE_B + trans_n[None, :] * M + trans_m[:, None], moved)


def _native_bank_layout(first, second, batch):
    pitch, head_pitch, cols = 12 * 128 * 768, 128 * 768, 768
    strides = (pitch, head_pitch, cols, 1)
    return (first.shape == (batch, 12, 128, cols) and second.shape == (batch, 6, 128, cols)
            and first.stride() == strides and second.stride() == strides
            and first.dtype == second.dtype == torch.bfloat16
            and first.is_cuda and second.device == first.device
            and torch.cuda.get_device_capability(first.device)[0] == 9)


def _native_cache_buffers(cache, device, batch, rows):
    partials, scales, row, col = cache.partial_amax, cache.scales, cache.row, cache.col
    cols = 768
    # The pinned cache creates these four buffers separately in its constructor.
    if (partials.shape != (batch, 32) or scales.shape != (batch,)
            or row.shape != (batch, rows, cols) or col.shape != (batch, cols, rows)
            or partials.dtype != torch.float32 or scales.dtype != torch.float32
            or row.dtype != torch.float8_e4m3fn or col.dtype != row.dtype
            or any(buf.device != device or not buf.is_contiguous()
                   for buf in (partials, scales, row, col))):
        return None
    return partials, scales, row, col


def refresh_native_qkv(cache, first, second, first_width, second_width):
    batch = first.shape[0]
    if ((batch, first_width, second_width) not in ((3, 64, 128), (2, 64, 64), (2, 128, 128))
            or not _native_bank_layout(first, second, batch)):
        return False
    pitch, cols = 12 * 128 * 768, 768
    first_rows, second_rows = 12 * first_width, 6 * second_width
    rows = first_rows + second_rows
    buffers = _native_cache_buffers(cache, first.device, batch, rows)
    if buffers is None:
        return False
    partials, scales, row, col = buffers
    head_crop = dict(QK_CROP=first_width == 64, V_CROP=second_width == 64)
    _aligned_packed_amax[(batch, 32)](
        first, second, partials, FIRST_ELEMENTS=first_rows * cols, SECOND_ELEMENTS=second_rows * cols,
        FIRST_STRIDE_B=pitch, SECOND_STRIDE_B=pitch, NUM_PARTS=32, BLOCK_SIZE=2048,
        num_stages=1, num_warps=8, **head_crop,
    )
    _qkv_scale_from_partials[(batch,)](partials, scales, num_warps=1)
    _quantize_qkv_tiles_gluon[(rows // 64, cols // 128, batch)](
        first, second, row, col, scales, M=rows, N=cols, FIRST_ROWS=first_rows,
        FIRST_STRIDE_B=pitch, SECOND_STRIDE_B=pitch, ROW_STRIDE_B=rows * cols,
        TRANSPOSED_STRIDE_B=rows * cols, BLOCK_M=64, BLOCK_N=128,
        num_stages=2, num_warps=8, **head_crop,
    )
    return True


@triton.jit
def _qkv_scan_bank(bank, lane, part, count, cropped, local_amax, QK: tl.constexpr):
    # Three visits advance by 96 logical tiles and cross four cropped heads.
    stride = tl.where(cropped, 192, 96)
    blocks = count // 3
    for block in tl.range(0, blocks):
        for phase in tl.static_range(3):
            tile = part + 32 * phase
            initial = tile + tl.where(cropped, (tile // 24) * 24, 0)
            offset = block * stride + initial
            values = tl.load(bank + offset * 2048 + lane).to(tl.float32)
            magnitude = tl.abs(values + 0.0) if QK else tl.abs(0.0 + values)
            local_amax = tl.maximum(local_amax, magnitude)
    if not QK:
        for phase in tl.static_range(2):
            if phase < count % 3:
                tile = part + 32 * phase
                initial = tile + tl.where(cropped, (tile // 24) * 24, 0)
                offset = blocks * stride + initial
                values = tl.load(bank + offset * 2048 + lane).to(tl.float32)
                local_amax = tl.maximum(local_amax, tl.abs(0.0 + values))
    return local_amax


@triton.jit
def _grouped_qkv_scan(first, second, partial0, partial1, partial2):
    batch = tl.program_id(0)
    part = tl.program_id(1)
    narrow = batch < 3
    wide = batch >= 5
    local_batch = batch - tl.where(narrow, 0, tl.where(wide, 5, 3))
    partial = tl.where(narrow, partial0, tl.where(wide, partial2, partial1))
    lane = tl.arange(0, 2048)
    first_count = tl.where(wide, 18, 9)
    second_count = tl.where(narrow | wide, 9, 4 + (part < 16).to(tl.int32))
    first += batch * 1179648
    second += batch * 1179648
    local_amax = tl.zeros((2048,), tl.float32)
    local_amax = _qkv_scan_bank(first, lane, part, first_count, ~wide, local_amax, True)
    local_amax = _qkv_scan_bank(second, lane, part, second_count, ~(narrow | wide), local_amax, False)
    tl.store(partial + local_batch * 32 + part, tl.max(local_amax, axis=0))


@triton.jit
def _grouped_qkv_scale(partial0, partial1, partial2, scale0, scale1, scale2):
    batch = tl.program_id(0)
    narrow = batch < 3
    wide = batch >= 5
    local_batch = batch - tl.where(narrow, 0, tl.where(wide, 5, 3))
    partial = tl.where(narrow, partial0, tl.where(wide, partial2, partial1))
    scales = tl.where(narrow, scale0, tl.where(wide, scale2, scale1))
    parts = tl.arange(0, 32)
    partials = tl.load(partial + local_batch * 32 + parts)
    amax = tl.reduce(partials, 0, _qkv_scale_combine)
    floored = tl.where(amax < 1.0e-12, 1.0e-12, amax)
    tl.store(scales + local_batch, floored * (1.0 / 448.0))


@gluon.jit
def _grouped_qkv_pack(first, second, row0, row1, row2, col0, col1, col2, scale0, scale1, scale2):
    INPUT: gl.constexpr = gl.BlockedLayout([2, 16], [4, 8], [8, 1], [1, 0])
    TRANS: gl.constexpr = gl.BlockedLayout([8, 4], [1, 32], [8, 1], [0, 1])
    band = gl.program_id(2)
    start_n = gl.program_id(1) * 128
    narrow = band < 12
    wide = band >= 18
    # Slot beginnings in units of six row tiles: 0, 4, 8, 12, 15, 18, 24.
    # Count preceding beginnings and find the latest one without integer division.
    eligible = ((2 << band) - 1) & 0x1049111
    count, first_band = gl.inline_asm_elementwise(
        "{ popc.b32 $0, $2; bfind.u32 $1, $2; }", constraints="=r,=r,r",
        args=[eligible], dtype=(gl.int32, gl.int32), is_pure=True, pack=1,
    )
    batch = count - 1
    local_batch = batch - gl.where(narrow, 0, gl.where(wide, 5, 3))
    start_m = (band - first_band) * 384 + gl.program_id(0) * 64
    M = gl.where(narrow, 1536, gl.where(wide, 2304, 1152))
    first_rows = gl.where(wide, 1536, 768)
    qk = start_m < first_rows
    bank = gl.where(qk, first, second)
    crop = gl.where(qk, ~wide, ~(narrow | wide))
    bank_row = (start_m - gl.where(qk, 0, first_rows)) * gl.where(crop, 2, 1)
    source = bank + (batch * 1179648 + bank_row * 768 + start_n)
    rows = gl.arange(0, 64, layout=gl.SliceLayout(1, INPUT))
    cols = gl.arange(0, 128, layout=gl.SliceLayout(0, INPUT))
    values = gl.load(source + (rows[:, None] * 768 + cols[None, :])).to(gl.float32)
    scale = gl.where(narrow, scale0, gl.where(wide, scale2, scale1))
    scaled = values / gl.load(scale + local_batch)
    quantized = gl.maximum(gl.minimum(scaled, 448.0), -448.0).to(gl.float8e4nv)
    row = gl.where(narrow, row0, gl.where(wide, row2, row1))
    col = gl.where(narrow, col0, gl.where(wide, col2, col1))
    out = local_batch * M * 768
    gl.store(row + (out + start_m * 768 + start_n) + (rows[:, None] * 768 + cols[None, :]), quantized)
    moved = gl.convert_layout(quantized, TRANS)
    trans_m = gl.arange(0, 64, layout=gl.SliceLayout(1, TRANS))
    trans_n = gl.arange(0, 128, layout=gl.SliceLayout(0, TRANS))
    gl.store(col + (out + start_n * M + start_m) + (trans_n[None, :] * M + trans_m[:, None]), moved)


def refresh_grouped_qkv(caches, first, second):
    if not _native_bank_layout(first, second, 7):
        return False
    buffers = []
    for name, batch, rows in (("narrow", 3, 1536), ("half_v", 2, 1152), ("wide", 2, 2304)):
        if name not in caches:
            return False
        group = _native_cache_buffers(caches[name], first.device, batch, rows)
        if group is None:
            return False
        buffers.append(group)
    partials, scales, row, col = zip(*buffers)
    _grouped_qkv_scan[(7, 32)](first, second, *partials, num_stages=1, num_warps=8)
    _grouped_qkv_scale[(7,)](*partials, *scales, num_warps=1)
    _grouped_qkv_pack[(6, 6, 30)](first, second, *row, *col, *scales, num_stages=2, num_warps=8)
    return True


def quantize_dual_layout_packed_batched(first, second, scales, partial_amax, row, transposed):
    """Exact-scale dual-layout quantization of the row concatenation [first; second], per batch entry."""
    B, first_rows, N = first.shape
    B2, second_rows, N2 = second.shape
    total_rows = first_rows + second_rows
    num_parts = partial_amax.shape[-1]
    assert (B2, N2) == (B, N) and first.device == second.device and first.dtype == second.dtype
    # Row-major sources: a strided dim-0 view of a bank is fine, a row-strided view is not.
    assert first.stride(1) == second.stride(1) == N and first.stride(2) == second.stride(2) == 1
    assert scales.shape == (B,) and partial_amax.shape == (B, num_parts)
    assert row.shape == (B, total_rows, N) and transposed.shape == (B, N, total_rows)
    assert row.dtype == transposed.dtype == torch.float8_e4m3fn
    assert row.is_contiguous() and transposed.is_contiguous()
    scan = _packed_batched_matrix_amax_partial_kernel
    if num_parts == 32 and first_rows * N % 2048 == 0 and second_rows * N % 2048 == 0:
        scan = _aligned_packed_amax
    scan[(B, num_parts)](
        first, second, partial_amax,
        FIRST_ELEMENTS=first_rows * N, SECOND_ELEMENTS=second_rows * N,
        FIRST_STRIDE_B=first.stride(0), SECOND_STRIDE_B=second.stride(0),
        NUM_PARTS=num_parts, BLOCK_SIZE=2048, num_stages=1, num_warps=8,
    )
    # Exact-current scale: amax / 448, no headroom.
    partial_start, scale_start = partial_amax.data_ptr(), scales.data_ptr()
    separate_scale = (partial_start + partial_amax.nbytes <= scale_start
                      or scale_start + scales.nbytes <= partial_start)
    if (num_parts == 32 and partial_amax.dtype == scales.dtype == torch.float32
            and partial_amax.is_contiguous() and scales.is_contiguous()
            and partial_amax.device == scales.device and separate_scale and B > 0):
        _qkv_scale_from_partials[(B,)](partial_amax, scales, num_warps=1)
    else:
        torch.mul(partial_amax.amax(dim=1).clamp_(min=1.0e-12), 1.0 / 448.0, out=scales)
    block_m, block_n = 64, 128
    grid = (triton.cdiv(total_rows, block_m), triton.cdiv(N, block_n), B)
    pack = _quantize_dual_layout_packed_batched_kernel
    max_pitch = max(first.stride(0), second.stride(0), total_rows * N)
    if (first_rows % block_m == 0 and total_rows % block_m == 0 and N % block_n == 0
            and B * max_pitch < (1 << 31)):
        if first.is_cuda and torch.cuda.get_device_capability(first.device)[0] == 9:
            pack = _quantize_qkv_tiles_gluon
        else:
            pack = _quantize_aligned_qkv_tiles
    pack[grid](
        first, second, row, transposed, scales,
        total_rows, N,
        FIRST_ROWS=first_rows,
        FIRST_STRIDE_B=first.stride(0), SECOND_STRIDE_B=second.stride(0),
        ROW_STRIDE_B=row.stride(0), TRANSPOSED_STRIDE_B=transposed.stride(0),
        BLOCK_M=block_m, BLOCK_N=block_n, num_stages=2, num_warps=8,
    )
    return row, transposed


class PackedQKVFP8Cache(nn.Module):
    """The fp8 [Q; K; V] weights of one batch of same-shaped attention layers, in both layouts.

    Buffers (none persistent: every refresh rewrites them from the banks):
      row    [layers, rows, cols]  e4m3, the forward GEMM's operand
      col    [layers, cols, rows]  e4m3, the input-gradient GEMM's operand
      scales [layers]              each layer's exact dequant scale
    """
    def __init__(self, num_layers: int, rows: int, cols: int, device: torch.device):
        super().__init__()
        e4m3 = torch.float8_e4m3fn
        self.register_buffer("row", torch.empty(num_layers, rows, cols, dtype=e4m3, device=device), persistent=False)
